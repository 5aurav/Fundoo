{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "FundooConnection": "Host=localhost;Port=5432;Database=FundooDB;Username=postgres;Password=YOUR_PASSWORD"
  },

  "Jwt": {
    "Key": "JWT_SECRET_KEY",
    "Issuer": "FundooApi",
    "Audience": "FundooClient",
    "ExpiresInMinutes": 60
  }
}